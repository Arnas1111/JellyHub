# Optional process environment; configure integrations through Connections.
# Saved /config/settings.json values override service environment defaults.
# Node does not automatically load this file.
PORT=3000
CONFIG_DIR=/config
JELLYFIN_URL=http://jellyfin:8096
# Set 1 when the browser accesses JellyHub using HTTPS.
COOKIE_SECURE=0
# Optional bootstrap logging; change and persist through Connections.
LOG_LEVEL=info
# Optional Docker runtime IDs. Ownership initialization runs before dropping privileges.
PUID=1000
PGID=1000
