# Internal addresses reachable FROM the JellyHub container (same Docker network)
JELLYFIN_URL=http://jellyfin:8096
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
# Default to api/v3 for current Arr installations. Override if your version differs.
SONARR_API_PATH=/api/v3
RADARR_API_PATH=/api/v3
# Jellystat read-only integration requires version-specific auth: not enabled in v0.1
JELLYSTAT_URL=http://jellystat:3000
PORT=3000
# Set 1 only behind HTTPS proxy. localhost HTTP development: 0.
COOKIE_SECURE=0

# Maintainerr read-only deletion countdown integration (internal Docker DNS only)
MAINTAINERR_URL=http://Maintainerr:6246
